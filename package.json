{
  "name": "@lunaticmuch/opencode-nanogpt-plugin",
  "version": "1.1.5",
  "type": "module",
  "description": "OpenCode v2 TUI plugin showing NanoGPT usage and subscription usage",
  "license": "MIT",
  "author": "Stefano Cislaghi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunaticMuch/opencode-nanogpt-plugin.git"
  },
  "homepage": "https://github.com/LunaticMuch/opencode-nanogpt-plugin",
  "bugs": {
    "url": "https://github.com/LunaticMuch/opencode-nanogpt-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "nanogpt",
    "nano-gpt",
    "usage",
    "plugin"
  ],
  "main": "./dist/tui.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.1",
    "prettier": "^3.9.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
